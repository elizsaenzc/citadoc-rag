# Copy to .env and fill in what you use. Without keys the app runs in demo mode.

# LLM: demo | azure | anthropic | openai (any OpenAI-compatible API: OpenAI, OpenRouter, Ollama...)
CITADOC_LLM_PROVIDER=demo
CITADOC_LLM_MODEL=claude-sonnet-4-5
CITADOC_ANTHROPIC_API_KEY=
CITADOC_OPENAI_API_KEY=
CITADOC_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (CITADOC_LLM_PROVIDER=azure and/or CITADOC_EMBEDDING_PROVIDER=azure)
CITADOC_AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
CITADOC_AZURE_OPENAI_API_KEY=
CITADOC_AZURE_OPENAI_API_VERSION=2024-10-21
CITADOC_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
CITADOC_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Embeddings: hashing (local, no key) | azure | openai
CITADOC_EMBEDDING_PROVIDER=hashing
CITADOC_EMBEDDING_MODEL=text-embedding-3-small

# Vector store: memory | pgvector
CITADOC_VECTOR_STORE=memory
CITADOC_DATABASE_URL=
